/* ============================================================
   EduPaie - Charte graphique
   Segoe UI Variable - Style moderne
   ============================================================ */

/* ----- Base ----- */
QWidget {
    font-family: "Segoe UI Variable Display", "Segoe UI", Arial, sans-serif;
    font-size: 13px;
    color: #1E293B;
    background-color: #F8FAFC;
}

QMainWindow, QDialog {
    background-color: #F8FAFC;
}

/* ----- Barre laterale ----- */
#SideBar {
    background-color: #1E3A8A;
    border: none;
    min-width: 220px;
    max-width: 220px;
}

#SideBar QLabel#Logo {
    color: #FFFFFF;
    font-family: "Segoe UI Variable Display", "Segoe UI", Arial, sans-serif;
    font-size: 24px;
    font-weight: 700;
    letter-spacing: 4px;
    padding: 24px 16px 4px 16px;
    background-color: #1E3A8A;
}

#SideBar QLabel#Subtitle {
    color: #93C5FD;
    font-family: "Segoe UI Variable Display", "Segoe UI", Arial, sans-serif;
    font-size: 10px;
    letter-spacing: 2px;
    padding: 0px 16px 20px 16px;
    background-color: #1E3A8A;
}

#SideBar QPushButton {
    color: #E0E7FF;
    background-color: transparent;
    border: none;
    padding: 14px 16px;
    text-align: left;
    font-family: "Segoe UI Variable Display", "Segoe UI", Arial, sans-serif;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.5px;
    border-left: 3px solid transparent;
}

#SideBar QPushButton:hover {
    background-color: #1E40AF;
    color: #FFFFFF;
}

#SideBar QPushButton:checked {
    background-color: #2563EB;
    color: #FFFFFF;
    font-weight: 600;
}

/* ----- Titres ----- */
QLabel#Title {
    font-family: "Segoe UI Variable Display", "Segoe UI", Arial, sans-serif;
    font-size: 24px;
    font-weight: 700;
    color: #1E3A8A;
    padding: 8px 0;
    letter-spacing: 0.5px;
}

QLabel#Subtitle {
    font-family: "Segoe UI Variable Display", "Segoe UI", Arial, sans-serif;
    font-size: 13px;
    color: #64748B;
}

/* ----- Cartes ----- */
QFrame#Card {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 10px;
    padding: 14px;
}

QLabel#CardTitle {
    color: #64748B;
    font-family: "Segoe UI Variable Display", "Segoe UI", Arial, sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 1.5px;
}

QLabel#CardValue {
    color: #1E3A8A;
    font-family: "Segoe UI Variable Display", "Segoe UI", Arial, sans-serif;
    font-size: 26px;
    font-weight: 700;
}

/* ----- Boutons ----- */
QPushButton {
    background-color: #2563EB;
    color: #FFFFFF;
    border: none;
    border-radius: 6px;
    padding: 10px 18px;
    font-family: "Segoe UI Variable Display", "Segoe UI", Arial, sans-serif;
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.3px;
    min-height: 34px;
}

QPushButton:hover {
    background-color: #1D4ED8;
}

QPushButton:pressed {
    background-color: #1E40AF;
}

QPushButton:disabled {
    background-color: #CBD5E1;
    color: #94A3B8;
}

QPushButton#Secondary {
    background-color: #F1F5F9;
    color: #1E293B;
    border: 1px solid #CBD5E1;
}

QPushButton#Secondary:hover {
    background-color: #E2E8F0;
}

QPushButton#Danger {
    background-color: #EF4444;
}

QPushButton#Danger:hover {
    background-color: #DC2626;
}

QPushButton#Success {
    background-color: #10B981;
}

QPushButton#Success:hover {
    background-color: #059669;
}

/* ----- Champs de saisie ----- */
QLineEdit, QComboBox, QDateEdit, QDoubleSpinBox, QSpinBox, QTextEdit {
    background-color: #FFFFFF;
    border: 1px solid #CBD5E1;
    border-radius: 6px;
    padding: 6px 10px;
    font-family: "Segoe UI Variable Display", "Segoe UI", Arial, sans-serif;
    font-size: 13px;
    min-height: 28px;
}

QLineEdit:focus, QComboBox:focus, QDateEdit:focus,
QDoubleSpinBox:focus, QSpinBox:focus, QTextEdit:focus {
    border: 1px solid #2563EB;
}

QLineEdit:disabled, QComboBox:disabled {
    background-color: #F1F5F9;
    color: #94A3B8;
}

/* ----- Tableaux ----- */
QTableView, QTableWidget {
    background-color: #FFFFFF;
    border: 1px solid #E2E8F0;
    border-radius: 8px;
    gridline-color: #F1F5F9;
    selection-background-color: #DBEAFE;
    selection-color: #1E3A8A;
    outline: none;
    font-family: "Segoe UI Variable Display", "Segoe UI", Arial, sans-serif;
}

QHeaderView::section {
    background-color: #F1F5F9;
    color: #475569;
    padding: 10px;
    border: none;
    border-bottom: 2px solid #E2E8F0;
    font-family: "Segoe UI Variable Display", "Segoe UI", Arial, sans-serif;
    font-weight: 600;
    font-size: 11px;
    letter-spacing: 1px;
}

QTableView::item {
    padding: 6px;
    border-bottom: 1px solid #F1F5F9;
}

QTableView::item:selected {
    background-color: #DBEAFE;
}

/* ----- Barre de recherche ----- */
QLineEdit#SearchBar {
    padding-left: 16px;
    min-height: 34px;
}

/* ----- Statuts ----- */
QLabel#StatusSolde {
    color: #10B981;
    font-weight: 700;
}
QLabel#StatusPartiel {
    color: #F59E0B;
    font-weight: 700;
}
QLabel#StatusNonPaye {
    color: #EF4444;
    font-weight: 700;
}

/* ----- Scrollbars ----- */
QScrollBar:vertical {
    background: #F1F5F9;
    width: 10px;
    border-radius: 5px;
}
QScrollBar::handle:vertical {
    background: #CBD5E1;
    border-radius: 5px;
    min-height: 30px;
}
QScrollBar::handle:vertical:hover {
    background: #94A3B8;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}